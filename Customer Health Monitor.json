      "name": "Needs attention?"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a customer success manager at a workflow automation company.\nAccount: {{ $json.company }}\nHealth score: {{ $json.score }} ({{ $json.status }})\nUsage change vs last month: {{ $json.usage_change_pct }}%\nActive users: {{ $json.active_users }}\nDays since last login: {{ $json.days_since_login }}\nOpen tickets: {{ $json.open_tickets }}\n\nWrite the response in exactly this format, with no extra text:\n\nDIAGNOSIS: <one sentence on the likely risk>\nSUBJECT: <email subject line>\nEMAIL:\n<email body, under 90 words, friendly, offers help without sounding alarmed. Sign off as \"David, Customer Success\" and address the customer team generically, e.g. \"Hi team,\">\n",
        "batching": {}
      },
