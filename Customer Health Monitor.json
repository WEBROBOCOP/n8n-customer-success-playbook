        "sendTo": "csm@example.com",
        "subject": "=Health alert: {{ $json.company }}",
        "message": "=<p><b>Diagnosis:</b> {{ $json.diagnosis }}</p>\n\n<p><b>Suggested email to the customer</b><br>\n<b>Subject:</b> {{ $json.subject }}</p>\n\n<p>{{ $json.email.replace(/\\n/g, '<br>') }}</p>",
