      "id": "ad499a46-3b04-41c3-ad0a-b62fcf53dad8",
      "name": "Split into fields"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const a = item.json;\n  let score = 100;\n  const change = (a.executions_30d - a.executions_prev_30d) / a.executions_prev_30d;\n  if (change < -0.5) score -= 35; else if (change < -0.2) score -= 15;\n  if (a.days_since_login > 30) score -= 30; else if (a.days_since_login > 14) score -= 15;\n  if (a.active_users < 5) score -= 15;\n  if (a.open_tickets >= 3) score -= 15;\n  const status = score >= 75 ? \"Healthy\" : score >= 50 ? \"Watch\" : \"At risk\";\n  return { json: { ...a, usage_change_pct: Math.round(change * 100), score, status } };\n});"
      },
      "type": "n8n-nodes-base.code",
