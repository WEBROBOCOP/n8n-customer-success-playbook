        "jsCode": "const accounts = [\n  { company: \"Acme GmbH\", executions_30d: 1200, executions_prev_30d: 1100, active_users: 14, days_since_login: 2, open_tickets: 0 },\n  { company: \"Nordlicht AG\", executions_30d: 300, executions_prev_30d: 900, active_users: 4, days_since_login: 18, open_tickets: 3 },\n  { company: \"Lisboa Retail\", executions_30d: 800, executions_prev_30d: 820, active_users: 4, days_since_login: 16, open_tickets: 1 },\n  { company: \"Dublin Fintech\", executions_30d: 90, executions_prev_30d: 400, active_users: 2, days_since_login: 31, open_tickets: 2 },\n  { company: \"Madrid Logistics\", executions_30d: 2100, executions_prev_30d: 1500, active_users: 22, days_since_login: 1, open_tickets: 0 }\n];\nreturn accounts.map(a => ({ json: a }));"
